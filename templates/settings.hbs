
<div class="llm-settings-container">
    <div class="form-group">
        <label>Provider</label>
        <div class="form-fields">
            <select name="provider">
                {{selectOptions providers selected=config.provider}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>API Endpoint</label>
        <div class="form-fields">
            <input type="text" name="apiEndpoint" value="{{config.apiEndpoint}}" placeholder="http://localhost:11434/api/generate">
        </div>
    </div>

    <div class="form-group">
        <label>API Key</label>
        <div class="form-fields">
            <input type="password" name="apiKey" value="{{config.apiKey}}">
        </div>
    </div>

    <div class="form-group">
        <label>Model Name</label>
        <div class="form-fields">
            <input type="text" name="model" value="{{config.model}}">
        </div>
    </div>

    <div class="form-group">
        <label>Context Window</label>
        <div class="form-fields">
            <input type="number" name="contextWindow" value="{{config.contextWindow}}">
        </div>
    </div>

    <div class="form-group">
        <label>System Prompt</label>
        <div class="form-fields">
            <textarea name="systemPrompt" rows="4">{{config.systemPrompt}}</textarea>
        </div>
    </div>

    <div class="form-group">
        <button type="button" id="llm-connect-button">
            {{#if isConnected}}
                <i class="fas fa-check"></i> Connected
            {{else}}
                <i class="fas fa-plug"></i> Connect
            {{/if}}
        </button>
    </div>

    <div class="form-footer">
        <button type="submit">
            <i class="fas fa-save"></i> Save Settings
        </button>
    </div>
</div>
